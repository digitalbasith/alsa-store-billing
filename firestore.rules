rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Alsa Store Billing is isolated by Firebase Authentication.
    // Only signed-in users can read/write app data. Public users cannot access data.
    // This avoids the first-login store bootstrap permission loop.
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
