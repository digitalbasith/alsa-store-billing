rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/store_members/$(request.auth.uid));
    }

    function isMember(storeId) {
      return signedIn()
        && exists(/databases/$(database)/documents/store_members/$(request.auth.uid))
        && memberDoc().data.active == true
        && memberDoc().data.store_id == storeId;
    }

    function isAdmin(storeId) {
      return isMember(storeId)
        && memberDoc().data.role in ['super_admin', 'admin'];
    }

    function isOwnerAfter(storeId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/stores/$(storeId)).data.owner_uid == request.auth.uid;
    }

    function invitedTo(storeId) {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/staff_invites/$(request.auth.token.email))
        && get(/databases/$(database)/documents/staff_invites/$(request.auth.token.email)).data.store_id == storeId
        && get(/databases/$(database)/documents/staff_invites/$(request.auth.token.email)).data.active == true;
    }

    match /stores/{storeId} {
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow read, update: if isMember(storeId);
      allow delete: if false;
    }

    match /store_members/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || isMember(resource.data.store_id));
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && (invitedTo(request.resource.data.store_id) || isOwnerAfter(request.resource.data.store_id));
      allow update, delete: if isAdmin(resource.data.store_id);
    }

    match /staff_invites/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin(resource.data.store_id));
      allow create: if isAdmin(request.resource.data.store_id);
      allow update: if isAdmin(resource.data.store_id);
      allow delete: if signedIn() && (request.auth.token.email == email || isAdmin(resource.data.store_id));
    }

    match /store_settings/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id) || isOwnerAfter(request.resource.data.store_id);
    }

    match /categories/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /products/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /product_barcodes/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /customers/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /suppliers/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /sales/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /sale_items/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /payments/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /purchases/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /purchase_items/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /sale_returns/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /purchase_returns/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /account_entries/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
    match /business_documents/{id} {
      allow read, update, delete: if isMember(resource.data.store_id);
      allow create: if isMember(request.resource.data.store_id);
    }
  }
}
